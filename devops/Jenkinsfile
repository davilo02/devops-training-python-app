// ---------- Función reutilizable ----------
def runInDocker(String image, Closure body) {
    docker.image(image).inside('-u 0:0') {
        body()
    }
}

pipeline {
    agent any

    stages {

        stage('Info') {
            steps {
                echo "Job: ${env.JOB_NAME}"
                echo "Build: ${env.BUILD_NUMBER}"
            }
        }

        stage('Lint') {
            steps {
                echo "Running Lint..."
                runInDocker('python:3.11-slim') {
                    sh '''
                        python -m venv .venv
                        .venv/bin/pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt flake8
                        .venv/bin/flake8 src/ || true
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                echo "Running Tests..."
                runInDocker('python:3.11-slim') {
                    sh '''
                        python -m venv .venv
                        .venv/bin/pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt pytest
                        .venv/bin/pytest --junitxml=test-reports/results.xml
                    '''
                }
                junit 'test-reports/results.xml'
            }
        }

    }
}
