// Función reutilizable para ejecutar comandos dentro de un contenedor Docker
def runInDocker(String image, Closure body) {
    docker.image(image).inside('-u 0:0') {
        body()
    }
}

// Pipeline principal - define el flujo CI/CD completo
pipeline {
    // Ejecutar en cualquier agente disponible de Jenkins
    agent any

    // Variables de entorno reutilizables en todos los stages
    environment {
        IMAGE_NAME = "python-app:${BUILD_NUMBER}"
        APP_URL    = "http://localhost:5001/"
    }

    // Parámetros configurables desde la UI de Jenkins
    parameters {
        booleanParam(name: 'RUN_CD', defaultValue: false, description: 'Ejecutar CD (solo develop/master)')
    }

    stages {
        // Stage informativo: muestra datos del build y variables de entorno
        stage('Info') {
            steps {
                echo "Job: ${env.JOB_NAME}"
                echo "Build: ${env.BUILD_NUMBER}"
                echo "Imagen: ${env.IMAGE_NAME}"
                sh "echo APP_URL=${APP_URL}"
            }
        }

        // Stage de calidad: analiza el código con flake8 (no bloquea el pipeline)
        stage('Lint') {
            steps {
                echo "Running Lint..."
                runInDocker('python:3.11-slim') {
                    sh '''
                        python -m venv .venv
                        .venv/bin/pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt flake8
                        .venv/bin/flake8 src/ || true
                    '''
                }
            }
        }

        // Stage de pruebas: ejecuta tests unitarios y publica resultados JUnit
        stage('Test') {
            steps {
                echo "Running Tests..."
                runInDocker('python:3.11-slim') {
                    sh '''
                        python -m venv .venv
                        .venv/bin/pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt pytest
                        .venv/bin/pytest --junitxml=test-reports/results.xml
                    '''
                }
                junit 'test-reports/results.xml'
            }
        }

        // Stage de construcción: genera la imagen Docker
        stage('Build image') {
            steps {
                echo "Building Docker image ${env.IMAGE_NAME}..."
                script {
                    docker.build("${env.IMAGE_NAME}", "-f devops/Dockerfile .")
                    echo "Image built: ${env.IMAGE_NAME}"
                }
            }
        }

        // Stage de despliegue: solo se ejecuta en develop/master y si RUN_CD=true
        stage('CD') {
            when {
                allOf {
                    anyOf {
                        branch 'develop'
                        branch 'master'
                    }
                    // Requiere activación manual mediante parámetro
                    expression { return params.RUN_CD }
                }
            }
            steps {
                echo "CD habilitado por parámetro RUN_CD=${params.RUN_CD}"
                script {
                    // Determina el entorno según la rama: master=PRO, resto=DEV
                    env.DEPLOY_ENV = (env.BRANCH_NAME == 'master') ? 'PRO' : 'DEV'
                    echo "Deploying to ${env.DEPLOY_ENV}"
                    echo "App URL: ${env.APP_URL}"
                    def project = env.DEPLOY_ENV.toLowerCase()
                    sh "docker compose -p ${project} -f docker-compose.yml up -d --no-deps app"
                    sleep 20
                    sh "docker exec ${project}-app-1 python -c \"import urllib.request; urllib.request.urlopen('http://localhost:5000/health')\""
                }
            }
            // Hooks post-stage: limpieza y reporte de resultado del despliegue
            post {
                always {
                    script {
                        def project = (env.BRANCH_NAME == 'master') ? 'pro' : 'dev'
                        sh "docker compose -p ${project} -f docker-compose.yml down --volumes || true"
                        sh "docker rmi ${env.IMAGE_NAME} || true"
                    }
                }
                success {
                    echo 'SUCCESS'
                }
                failure {
                    echo 'FAILURE'
                    script {
                        def project = (env.BRANCH_NAME == 'master') ? 'pro' : 'dev'
                        sh "docker compose -p ${project} -f docker-compose.yml logs || true"
                    }
                }
            }
        }
    }

    // Hooks post-pipeline: se ejecutan siempre al finalizar, independientemente del resultado
    post {
        always {
            echo "Pipeline finalizado para ${env.IMAGE_NAME}"
        }
        success {
            echo 'Pipeline SUCCESS'
        }
        failure {
            echo 'Pipeline FAILURE'
        }
    }
}
