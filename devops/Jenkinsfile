// ---------- Función reutilizable ----------
def runInDocker(String image, Closure body) {
    docker.image(image).inside('-u 0:0') {
        body()
    }
}
pipeline {
    agent any
    stages {
        stage('Info') {
            steps {
                echo "Job: ${env.JOB_NAME}"
                echo "Build: ${env.BUILD_NUMBER}"
            }
        }
        stage('Lint') {
            steps {
                echo "Running Lint..."
                runInDocker('python:3.11-slim') {
                    sh '''
                        python -m venv .venv
                        .venv/bin/pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt flake8
                        .venv/bin/flake8 src/ || true
                    '''
                }
            }
        }
        stage('Test') {
            steps {
                echo "Running Tests..."
                runInDocker('python:3.11-slim') {
                    sh '''
                        python -m venv .venv
                        .venv/bin/pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt pytest
                        .venv/bin/pytest --junitxml=test-reports/results.xml
                    '''
                }
                junit 'test-reports/results.xml'
            }
        }
        stage('Build image') {
            steps {
                echo "Building Docker image..."
                script {
                    def imageName = "python-app:${env.BUILD_NUMBER}"
                    docker.build(imageName, "-f devops/Dockerfile .")
                    echo "Image built: ${imageName}"
                }
            }
        }
        stage('CD') {
            when {
                anyOf {
                    branch 'develop'
                    branch 'master'
                }
            }
            steps {
                script {
                    env.DEPLOY_ENV = (env.BRANCH_NAME == 'master') ? 'PRO' : 'DEV'
                    echo "Deploying to ${env.DEPLOY_ENV}"
                    def project = env.DEPLOY_ENV.toLowerCase()
                    try {
                        sh "docker compose -p ${project} -f docker-compose.yml up -d --no-deps app"
                        sleep 20
                        sh "docker exec ${project}-app-1 python -c \"import urllib.request; urllib.request.urlopen('http://localhost:5000/health')\""
                    } finally {
                        sh "docker compose -p ${project} -f docker-compose.yml down --volumes"
                    }
                }
            }
        }
    }
}
