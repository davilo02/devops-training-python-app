pipeline {
    agent any
    environment {
        VENV = ".venv"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Info') {
            steps {
                echo "Job: ${env.JOB_NAME}"
                echo "Build: ${env.BUILD_NUMBER}"
            }
        }

        stage('Lint') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    args '-u 0:0'
                }
            }
            steps {
                sh '''
                    apt-get update && apt-get install -y make
                    python -m venv .venv
                    .venv/bin/pip install --upgrade pip
                    .venv/bin/pip install -r requirements.txt flake8
                    .venv/bin/flake8 src/ || true
                '''
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    args '-u 0:0'
                }
            }
            steps {
                sh '''
                    # Instala make y la virtualenv si no existe
                    apt-get update && apt-get install -y make
                    python -m venv .venv
                    .venv/bin/pip install --upgrade pip
                    .venv/bin/pip install -r requirements.txt pytest

                    # Ejecuta pytest usando la virtualenv
                    .venv/bin/pytest --junitxml=test-reports/results.xml
                '''
            }
        }
    }

    post {
        always {
            junit '**/test-reports/*.xml'
            archiveArtifacts artifacts: 'coverage*.xml, coverage_html/**/*', allowEmptyArchive: true
        }
        success {
            echo "Pipeline finished successfully!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
